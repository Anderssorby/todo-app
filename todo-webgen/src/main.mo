/// Generate the browser loader entry with content-hashed module URLs.
///
/// The vendored loader is three modules with static imports
/// (`web.js` -> `web_runtime.js` -> `float_format.js`). A cache-busting
/// query on `boot.js` alone would not reach those imports, so this generator
/// writes copies with each dependency's URL pinned to that dependency's
/// SHA-256, then renders `boot.js` with `jsgen` (the same emitter
/// `web_wasm` uses for the ABI loader). `web/boot.version` carries the hash
/// of `boot.js`, which the SSR shell turns into `/web/boot.js?v=<hash>`.
///
/// Usage (from the repository root, after building web/app.wasm):
///
///     monad build todo-webgen
///     ./target/debug/todo-webgen
use std::io {
  IO.read_file, IO.read_file_bytes, IO.write_file, IO.write_stderr, IO.write_stdout
}
use std::path {Path}
use std::sha256 {Sha256.hash_bytes}
use jsgen::js {Js.Expr, Js.Module, Js.Stmt, Js.render_module, Js.string_literal}

struct Sources {
  web_src : String,
  runtime_src : String,
  float_src : String,
  wasm : List U8
}

// ── hashing ─────────────────────────────────────────────────────────────

def Webgen.hex_digit (n : U8) : U8 :=
  if U8.lt n 10u8 then U8.add n 48u8 else U8.add n 87u8

def Webgen.hex_byte (b : U8) : List U8 :=
  let hi := U8.div b 16u8 in
  let lo := U8.sub b (U8.mul hi 16u8) in
  [Webgen.hex_digit hi, Webgen.hex_digit lo]

#[terminating]
def Webgen.hex_bytes (bytes : List U8) : List U8 :=
  match bytes {
    List.empty => List.empty,
    List.cons b rest => List.append (Webgen.hex_byte b) (Webgen.hex_bytes rest),
  }

def Webgen.hex_of (bytes : List U8) : String := String.from_list (Webgen.hex_bytes bytes)

def Webgen.hash_text (s : String) : String :=
  Webgen.hex_of (Sha256.hash_bytes (String.to_list s))

// ── one substring replacement ───────────────────────────────────────────

#[terminating]
def Webgen.find_from (needle : String) (hay : String) (i : I64) : Option I64 :=
  if I64.gt (I64.add i (String.length needle)) (String.length hay)
  then Option.none
  else if String.starts_with needle (String.drop i hay)
  then Option.some i
  else Webgen.find_from needle hay (I64.add i 1i64)

def Webgen.replace_once (needle : String) (replacement : String) (s : String) : String :=
  match Webgen.find_from needle s 0i64 {
    Option.some i =>
      String.concat (String.slice s 0i64 i)
        (String.concat replacement (String.drop (I64.add i (String.length needle)) s)),
    Option.none => s,
  }

// ── generated loader copies ──────────────────────────────────────────────

/// `web_runtime.js` with its float formatter pinned to `float_hash`.
def Webgen.runtime_copy (src : String) (float_hash : String) : String :=
  String.concat "// generated by todo-webgen from web_runtime.js; do not edit\n"
    (Webgen.replace_once "from './float_format.js'"
      (String.concat "from './float_format.js?v=" (String.concat float_hash "'")) src)

/// `web.js` with its runtime import pinned to the generated runtime copy.
def Webgen.web_copy (src : String) (runtime_hash : String) : String :=
  String.concat "// generated by todo-webgen from web.js; do not edit\n"
    (Webgen.replace_once "from \"./web_runtime.js\""
      (String.concat "from \"./web_runtime.gen.js?v="
        (String.concat runtime_hash "\"")) src)

// ── the generated boot entry ─────────────────────────────────────────────

def Webgen.mount_snippet : String :=
  "async (url, selector) => { host.set_root(selector); const response = await fetch(url); if (!response.ok) { throw new Error('todo-spa: ' + url + ' -> HTTP ' + response.status); } const bytes = await response.arrayBuffer(); const { instance } = await WebAssembly.instantiate(bytes, imports); host.bind(instance); if (instance.exports.oak_mount) instance.exports.oak_mount(); host.start_ticks(instance); return instance; }"

def Webgen.boot_snippet : String :=
  "if (typeof document !== 'undefined') { (async () => { try { await mount(APP_WASM_URL, '#app'); } catch (error) { console.error('todo-spa: failed to mount', error); } })(); }"

/// The `jsgen` module: hashed static imports, the wasm URL, the mount
/// function, and the browser-only boot call. The two snippets are
/// `Js.Expr.raw` (async/try are outside jsgen's tiny statement grammar), the
/// same escape hatch `web_wasm`'s `Glue.start_snippet` uses.
def Webgen.boot_module (web_hash : String) (runtime_hash : String)
    (wasm_hash : String) : Js.Module :=
  let imports : List Js.Stmt := [
    Js.Stmt.expr (Js.Expr.raw
      (String.concat "import { imports } from "
        (Js.string_literal (String.concat "./web.gen.js?v=" web_hash)))),
    Js.Stmt.expr (Js.Expr.raw
      (String.concat "import { host } from "
        (Js.string_literal (String.concat "./web_runtime.gen.js?v=" runtime_hash))))
  ] in
  let body : List Js.Stmt := [
    Js.Stmt.expr (Js.Expr.raw "export { imports, host }"),
    Js.Stmt.let_bind "APP_WASM_URL"
      (Js.Expr.string (String.concat "/web/app.wasm?v=" wasm_hash)),
    Js.Stmt.let_bind "mount" (Js.Expr.raw Webgen.mount_snippet),
    Js.Stmt.expr (Js.Expr.raw Webgen.boot_snippet)
  ] in
  { header := ["generated by todo-webgen from web.js/web_runtime.js -- do not edit"],
    imports := imports,
    body := body }

def Webgen.boot (web_hash : String) (runtime_hash : String) (wasm_hash : String) : String :=
  Js.render_module (Webgen.boot_module web_hash runtime_hash wasm_hash)

// ── file IO ─────────────────────────────────────────────────────────────

def Webgen.read_text (path : String) : IO (Result String String) := do {
  match Path.of path {
    Result.err e => return (Result.err e),
    Result.ok p => do {
      let r <- IO.read_file p;
      match r {
        Result.ok content => return (Result.ok content),
        Result.err e => return (Result.err e.message),
      }
    },
  }
}

def Webgen.read_bytes (path : String) : IO (Result String (List U8)) := do {
  match Path.of path {
    Result.err e => return (Result.err e),
    Result.ok p => do {
      let r <- IO.read_file_bytes p;
      match r {
        Result.ok content => return (Result.ok content),
        Result.err e => return (Result.err e.message),
      }
    },
  }
}

def Webgen.write_text (path : String) (content : String) : IO (Result String Unit) := do {
  match Path.of path {
    Result.err e => return (Result.err e),
    Result.ok p => do {
      let r <- IO.write_file p content;
      match r {
        Result.ok _ => return (Result.ok Unit.unit),
        Result.err e => return (Result.err e.message),
      }
    },
  }
}

#[terminating]
def Webgen.write_outputs (items : List (Pair String String)) : IO (Option String) :=
  match items {
    List.empty => return Option.none,
    List.cons item rest =>
      match item {
        Pair.pair path content => do {
          let r <- Webgen.write_text path content;
          match r {
            Result.ok _ => Webgen.write_outputs rest,
            Result.err e => return (Option.some (String.concat path (String.concat ": " e))),
          }
        },
      },
  }

def Webgen.load_sources : IO (Result String Sources) := do {
  let float_r <- Webgen.read_text "web/float_format.js";
  match float_r {
    Result.err e => return (Result.err (String.concat "web/float_format.js: " e)),
    Result.ok float_src => do {
      let runtime_r <- Webgen.read_text "web/web_runtime.js";
      match runtime_r {
        Result.err e => return (Result.err (String.concat "web/web_runtime.js: " e)),
        Result.ok runtime_src => do {
          let web_r <- Webgen.read_text "web/web.js";
          match web_r {
            Result.err e => return (Result.err (String.concat "web/web.js: " e)),
            Result.ok web_src => do {
              let wasm_r <- Webgen.read_bytes "web/app.wasm";
              match wasm_r {
                Result.err e => return (Result.err (String.concat "web/app.wasm: " e)),
                Result.ok wasm => do {
                  let sources : Sources :=
                    { web_src := web_src, runtime_src := runtime_src,
                      float_src := float_src, wasm := wasm };
                  return (Result.ok sources)
                },
              }
            },
          }
        },
      }
    },
  }
}

def Webgen.fail (message : String) : IO I64 := do {
  let _ <- IO.write_stderr (String.concat "todo-webgen: " (String.concat message "\n"));
  return 1i64
}

def main : IO I64 := do {
  let sources_r <- Webgen.load_sources;
  match sources_r {
    Result.err e => Webgen.fail e,
    Result.ok sources => do {
      let float_hash := Webgen.hash_text sources.float_src;
      let runtime_src := Webgen.runtime_copy sources.runtime_src float_hash;
      let runtime_hash := Webgen.hash_text runtime_src;
      let web_src := Webgen.web_copy sources.web_src runtime_hash;
      let web_hash := Webgen.hash_text web_src;
      let wasm_hash := Webgen.hex_of (Sha256.hash_bytes sources.wasm);
      let boot_src := Webgen.boot web_hash runtime_hash wasm_hash;
      let boot_hash := Webgen.hash_text boot_src;
      let outputs : List (Pair String String) := [
        Pair.pair "web/web_runtime.gen.js" runtime_src,
        Pair.pair "web/web.gen.js" web_src,
        Pair.pair "web/boot.js" boot_src,
        Pair.pair "web/boot.version" (String.concat boot_hash "\n")
      ];
      let write_err <- Webgen.write_outputs outputs;
      match write_err {
        Option.some e => Webgen.fail e,
        Option.none => do {
          let _ <- IO.write_stdout (String.concat "todo-webgen: boot.js " (String.concat boot_hash "\n"));
          return 0i64
        },
      }
    },
  }
}

// ── tests ───────────────────────────────────────────────────────────────

#[test]
def test_hex : Bool :=
  String.beq (Webgen.hex_of [0u8, 15u8, 16u8, 255u8]) "000f10ff"

#[test]
def test_replace_once : Bool :=
  String.beq (Webgen.replace_once "a" "b" "xax") "xbx"

#[test]
def test_replace_missing_is_identity : Bool :=
  String.beq (Webgen.replace_once "z" "b" "xax") "xax"

#[test]
def test_runtime_copy_pins_float : Bool :=
  String.contains
    (Webgen.runtime_copy "import { f64ToRustString } from './float_format.js';" "H")
    "float_format.js?v=H"

#[test]
def test_web_copy_pins_runtime : Bool :=
  String.contains
    (Webgen.web_copy "import { host } from \"./web_runtime.js\";" "H")
    "web_runtime.gen.js?v=H"

#[test]
def test_boot_pins_every_hash : Bool :=
  let src := Webgen.boot "W" "R" "A" in
  String.contains src "./web.gen.js?v=W"
  && String.contains src "./web_runtime.gen.js?v=R"
  && String.contains src "/web/app.wasm?v=A"
